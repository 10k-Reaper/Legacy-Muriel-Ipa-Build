diff --git a/.github/workflows/build-ios15-ipa.yml b/.github/workflows/build-ios15-ipa.yml
new file mode 100644
index 0000000..4919f76
--- /dev/null
+++ b/.github/workflows/build-ios15-ipa.yml
@@ -0,0 +1,89 @@
+name: Build iOS 15 IPA
+
+on:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: build-ios15-ipa-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  build:
+    name: Build unsigned IPA
+    runs-on: macos-15
+    env:
+      ELECTRON_SKIP_BINARY_DOWNLOAD: '1'
+
+    steps:
+      - name: Check out source
+        uses: actions/checkout@v4
+
+      - name: Set up Node.js
+        uses: actions/setup-node@v4
+        with:
+          node-version: 22
+          cache: npm
+
+      - name: Install dependencies
+        run: npm ci --no-audit --no-fund
+
+      - name: Check iOS 15 compatibility (source)
+        run: node tools/check-ios15-compat.mjs
+
+      - name: Build the iOS web bundle
+        run: node mobile/build.mjs
+
+      - name: Sync Capacitor iOS project
+        run: npx cap sync ios
+
+      - name: Check iOS 15 compatibility (after sync)
+        run: node tools/check-ios15-compat.mjs
+
+      - name: Compile for iOS (unsigned)
+        run: |
+          xcodebuild -quiet \
+            -project ios/App/App.xcodeproj \
+            -scheme App \
+            -configuration Release \
+            -sdk iphoneos \
+            -destination 'generic/platform=iOS' \
+            -derivedDataPath build \
+            CODE_SIGNING_ALLOWED=NO \
+            CODE_SIGNING_REQUIRED=NO \
+            CODE_SIGN_IDENTITY="" \
+            MARKETING_VERSION="$(node -p "require('./package.json').version")" \
+            CURRENT_PROJECT_VERSION="${{ github.run_number }}" \
+            build
+
+      - name: Confirm app is iOS 15 and widget is iOS 16.2
+        run: |
+          app="build/Build/Products/Release-iphoneos/App.app"
+          app_min=$(/usr/libexec/PlistBuddy -c 'Print :MinimumOSVersion' "$app/Info.plist")
+          widget_min=$(/usr/libexec/PlistBuddy -c 'Print :MinimumOSVersion' "$app/PlugIns/MurielWidgets.appex/Info.plist")
+          minos=$(otool -l "$app/App" | awk '/minos/{print $2; exit}')
+          test "$app_min" = "15.0"
+          test "$minos" = "15.0"
+          test "$widget_min" = "16.2"
+          echo "App minimum: $app_min (LC_BUILD_VERSION minos $minos)"
+          echo "Widget minimum: $widget_min"
+
+      - name: Package IPA
+        run: |
+          mkdir -p ipa/Payload
+          cp -R build/Build/Products/Release-iphoneos/App.app ipa/Payload/
+          (cd ipa && /usr/bin/zip -qry ../Muriel-iOS15.ipa Payload)
+          shasum -a 256 Muriel-iOS15.ipa > Muriel-iOS15.ipa.sha256
+          cat Muriel-iOS15.ipa.sha256
+
+      - name: Upload IPA artifact
+        uses: actions/upload-artifact@v4
+        with:
+          name: Muriel-iOS15-IPA
+          path: |
+            Muriel-iOS15.ipa
+            Muriel-iOS15.ipa.sha256
+          if-no-files-found: error
+          retention-days: 14
