+/* ---------- queue pane ---------- */
+/* the negative margin on the list made the pane wider than the screen, so it scrolled sideways */
+html.is-mobile #drawer-queue { overflow-x: hidden !important; }
+html.is-mobile #drawer-queue .tracks-list { margin: 0 !important; }
