+}
+/* the sheet's lyrics scroll only up and down; a long word used to widen the container and let the
+   whole text block drift sideways under the finger */
+html.is-mobile .lyrics-container,
+html.is-mobile .lyrics-section,
+html.is-mobile #right-panel { overflow-x: hidden !important; }
