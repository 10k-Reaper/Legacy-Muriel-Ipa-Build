+  let ctx = null;
+  let analyser = null;
+  let failed = false;
+  let wanted = false;
+  let lastPlayAttempt = 0;
+  let mirrorStartedAt = 0;
+  let mirrorBlocked = false;
+  let userPauseAt = 0;
